{
  "name": "backend-boilerplate",
  "version": "1.0.0",
  "description": "Boilerplate genérico para proyectos backend: Node + Fastify + PostgreSQL + Docker",
  "type": "module",
  "main": "dist/server.js",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --inspect=0.0.0.0:9229 src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate --tsx",
    "migrate:up": "node-pg-migrate up --tsx",
    "migrate:down": "node-pg-migrate down --tsx",
    "migrate:create": "node-pg-migrate create --tsx --template-file-name=./templates/migration.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:ui:docker": "node-pg-migrate up --tsx --no-verbose && vitest --ui --api.host 0.0.0.0 --no-open",
    "test:debug": "vitest --inspect-brk=0.0.0.0:9230 --no-file-parallelism run",
    "test:ci": "node-pg-migrate up --tsx --no-verbose && vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/postgres": "^6.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@scalar/fastify-api-reference": "^1.71.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "google-auth-library": "^11.1.0",
    "pg": "^8.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.13.0",
    "node-pg-migrate": "^7.6.1",
    "prettier": "^3.9.9",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
