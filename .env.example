NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@db:5432/app_dev
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Origen(es) permitidos para CORS: "*" (cualquiera), un origen único, o
# varios separados por comas. Por defecto "*"; en producción define los
# orígenes reales de tu frontend.
# CORS_ORIGIN=https://tuapp.com,https://admin.tuapp.com

# Límite de peticiones en /auth/google y /auth/refresh (por IP). Por defecto
# 10 cada 1 minute. Sube AUTH_RATE_LIMIT_MAX en entornos de test/CI para que
# la suite de integración no choque con el límite.
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW=1 minute

# Opcional: pon a "false" para desactivar la verificación TLS al construir las
# imágenes Docker (redes con proxy que intercepta TLS, como Netskope, que
# provocan errores "self-signed certificate in certificate chain"). Por
# defecto "true" (verificación activada).
# STRICT_SSL=false

# Opcional: solo para pruebas manuales con rest/auth.rest (leída vía
# {{$dotenv ...}} en el cliente REST). No es una variable usada por la app;
# accessToken/refreshToken se encadenan automáticamente desde la respuesta
# de /auth/google, no hace falta guardarlos aquí.
# GOOGLE_ID_TOKEN=
